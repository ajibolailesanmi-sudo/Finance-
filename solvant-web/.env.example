# Server-side only. Powers the "Ask Solvant" chat widget.
# Without it, the widget degrades gracefully to the booking link.
ANTHROPIC_API_KEY=

# Public booking URL used by every "Book a 15-minute intro call" CTA.
# [FILL] with your Cal.com link, e.g. https://cal.com/solvantlabs/intro
NEXT_PUBLIC_BOOKING_URL=

# Optional: your PUBLIC Cal.com link (no API key needed), e.g. solvantlabs/intro
# When set, the Contact page renders an inline Cal.com scheduler instead of a
# button. Leave blank to keep the plain booking button.
NEXT_PUBLIC_CAL_LINK=
