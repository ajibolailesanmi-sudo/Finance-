# Copy to .env (never commit it) or set these in your host's dashboard.

# --- Business --------------------------------------------------------------
BUSINESS_NAME=Mama Ngozi Wholesale
# Public https address of this server, used for the "payment done" page.
PUBLIC_URL=https://your-desk.onrender.com
# Staff phones that get order alerts and can send #commands, in international
# format without "+", comma-separated.
STAFF_WHATSAPP_NUMBERS=2348000000001,2348000000002
PORT=3000

# --- WhatsApp Cloud API (Meta) --------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you choose; type the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Used to check webhooks are really from Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# --- Paystack ----------------------------------------------------------------
# Use sk_test_... until you are ready to take real money.
PAYSTACK_SECRET_KEY=
# Paystack needs an email per payment; customers get wa<phone>@<this domain>.
ORDER_EMAIL_DOMAIN=orders.yourbusiness.ng

# --- Claude (reads customer messages) --------------------------------------
# Without a key the desk uses a simpler keyword reader.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Airtable (the shop's dashboard) ---------------------------------------
# Without these, data is kept in DATA_FILE on the server instead.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
DATA_FILE=data/store.local.json
