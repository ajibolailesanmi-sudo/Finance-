{
  "name": "whatsapp-order-desk",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp order desk: an AI agent that takes orders on a business's WhatsApp number, checks stock, sends a Paystack link, confirms payment and alerts staff.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "simulate": "tsx src/simulate.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
